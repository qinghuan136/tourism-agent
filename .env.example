# PostgreSQL 本地开发配置
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=travel_agent
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password

# OpenAI 或 OpenAI 兼容模型配置
TOURISM_AGENT_MODEL=gpt-4.1-mini
OPENAI_API_KEY=your_api_key
OPENAI_BASE_URL=https://api.openai.com/v1

# 默认关闭，开启后真实模型测试会产生网络请求和模型费用
RUN_LLM_INTEGRATION=false

# 旅行查询服务配置；QWeather Host 使用控制台分配的 API Host，不包含路径
QWEATHER_API_HOST=your-api-host.qweatherapi.com
QWEATHER_API_KEY=your_qweather_api_key
AMAP_WEB_SERVICE_KEY=your_amap_web_service_key
TAVILY_API_KEY=your_tavily_api_key

# 默认关闭，仅在本地验证 npm Tavily MCP Server 启动链路时设为 1
RUN_MCP_INTEGRATION=0

# 项目日志同时输出到控制台和轮转文件
TOURISM_LOG_LEVEL=INFO
TOURISM_LOG_FILE=logs/tourism-agent.log
